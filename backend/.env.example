# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=church_booking

# Used to sign admin login tokens - make this a long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# One-time secret required to create the FIRST admin account via
# POST /api/admin/register (pass it as `setup_secret` in the request body).
# Leave blank to disable admin registration entirely. After the first admin
# exists, further admins must be created by an already-logged-in admin.
ADMIN_SETUP_SECRET=

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://your-church-booking.vercel.app,https://booking.yourchurch.org
# Falls back to FRONTEND_URL below if not set.
CORS_ORIGINS=

# How many days ahead a booking is auto-approved without admin review
AUTO_APPROVE_WINDOW_DAYS=14

# Email — sent via the church's real Gmail account over SMTP.
# 1. Turn on 2-Step Verification on that Google account (Google Account ->
#    Security -> 2-Step Verification). Required before Google will let you
#    create an App Password.
# 2. Google Account -> Security -> 2-Step Verification -> App passwords ->
#    create one (name it "Room Booking System"). Copy the 16-character code
#    it gives you — that's EMAIL_PASSWORD, NOT the account's normal login
#    password (that won't work for SMTP).
# 3. EMAIL_FROM is that Gmail address itself (also used as the SMTP login).
#    EMAIL_FROM_NAME is just the friendly display name recipients see.
EMAIL_FROM=bookings@yourchurch.org
EMAIL_FROM_NAME=Pinehurst Campus Bookings
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Meta WhatsApp Cloud API - https://developers.facebook.com/docs/whatsapp/cloud-api
# Free tier: 1,000 service conversations/month
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Comma separated admin notification numbers/emails for new approval requests
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_WHATSAPP=

# Google Calendar two-way sync. Create a service account in Google Cloud
# Console, enable the Calendar API, download its JSON key and paste the
# ENTIRE contents here as one line. Then share the target Google Calendar
# with the service account's email address (found in the JSON as
# "client_email"), granting "Make changes to events". GOOGLE_CALENDAR_ID is
# that calendar's id (Calendar settings -> Integrate calendar -> Calendar
# ID). Leave both blank to disable sync.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Frontend URL (used in email/whatsapp links back to "manage my booking")
FRONTEND_URL=http://localhost:5173
